{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "NodeNext",
    "resolveJsonModule": true,
    "paths": {
      "graceful-fs": ["../compiled/graceful-fs"]
    }
  },
  "include": ["src", "src/**/*.json"],
  "exclude": [
    "src/config/schema.check.js",
    "src/container/default.runtime.js",
    "src/loader-runner/fixtures/**"
  ],
  "ts-node": {
    "transpileOnly": true
  }
}
